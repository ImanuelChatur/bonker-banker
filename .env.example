GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-flash-latest

# --- Login (see routes/auth.py) ---
# Signs the session cookie. REQUIRED when hosting: a long random string, e.g. from
#   python -c "import secrets; print(secrets.token_hex(32))"
BB_SECRET_KEY=change-me
# Login is on by default. Set to off only for local development.
BB_AUTH=on
# Set to 1 once the site is served over HTTPS (cookie is then never sent over plain HTTP).
BB_COOKIE_SECURE=0
# Optional: where login accounts are stored (default uploads/users.db). Create accounts with:
#   python scripts/create_user.py add <username>
# BB_USERS_DB=uploads/users.db
